# Trueqer API Gateway Environment Variables
NODE_ENV=development
PORT=5001

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=trueqer_user
DB_PASSWORD=secret_db_password
DB_NAME=trueqer_db
DB_CONNECTION_LIMIT=10

# Security & Tokens
JWT_SECRET=super_secret_jwt_signing_key_for_testing
PROXIMITY_RADIUS_METERS=150
